# Template for /etc/wpa_supplicant/wpa_supplicant-wlan0.conf (read by
# wpa_supplicant@wlan0.service). This image ships NO credentials.
#
# Easiest: run on the board   wifi-sta-setup <SSID> [<country>]
# (passphrase is read from stdin and stored hashed).
#
# By hand:
#   cp /etc/wpa_supplicant/wpa_supplicant-wlan0.conf.example \
#      /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
#   chmod 600 /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
#   wpa_passphrase '<SSID>' '<passphrase>'   # paste its network={} block below
#   systemctl restart wpa_supplicant@wlan0
#
ctrl_interface=/run/wpa_supplicant
ctrl_interface_group=0
update_config=1
# Two-letter regulatory domain, e.g. CA, US, DE.
country=US

#network={
#	ssid="<SSID>"
#	psk=<64 hex digits from wpa_passphrase>
#	key_mgmt=WPA-PSK
#}
