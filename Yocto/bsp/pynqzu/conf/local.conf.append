# Ethernet FMC Zynq GEM overrides for pynqzu (ZynqMP), EDF flow.
# bsp/pynqzu gets its own MACHINE/SDT from its own Vivado XSA via
# gen-machineconf parse-sdt (PS + PL device tree derived from hardware);
# MACHINE is NOT pinned. Console is the PS UART (ttyPS0). The EDF wks puts rootfs on /dev/mmcblk0p3.

# Kernel command line. APPEND is NOT read by the EDF boot flow. On ZynqMP the
# cmdline is built by boot.scr (meta-amd-edf edf-linux-mmc-boot.cmd): DT
# /chosen/bootargs ("earlycon console=ttyPS0,115200 clk_ignore_unused
# init_fatal_sh=1", emitted by sdtgen) + "root=/dev/mmcblk<N>p3 ro rootwait
# uio_pdrv_genirq.of_id=generic-uio". BSP_EXTRA_BOOTARGS is appended to it by
# meta-user/recipes-bsp/u-boot/u-boot-edf-scr_%.bbappend.
# Design args follow PetaLinux/bsp/pynqzu CONFIG_SUBSYSTEM_USER_CMDLINE.
# No "rw": root is mounted ro and systemd-remount-fs remounts it rw (fstab "/" defaults).
BSP_EXTRA_BOOTARGS = "cma=1536M"

# Hostname. meta-amd-edf's distro conf sets hostname:pn-base-files:amd-edf =
# "amd-edf"; it is parsed after local.conf and its extra override outranks a
# plain hostname:pn-base-files, so use :forcevariable (last in OVERRIDES).
hostname:pn-base-files:forcevariable = "pynqzu-zynqgem-2025-2"

# Serial getty on the console UART only. meta-xilinx-core zynqmp-generic.conf
# defaults to "ttyPS0 ttyPS1"; on PYNQ-ZU only UART0 (ttyPS0) reaches the USB-UART,
# and a getty on ttyPS1 keeps exiting until systemd gives up on it (state
# "degraded"). The generated machine conf does not set it, so a plain
# assignment here wins over the ?= default.
SERIAL_CONSOLES = "115200;ttyPS0"

# Reserve space in the rootfs for image-time installs.
IMAGE_ROOTFS_EXTRA_SPACE = "524288"
